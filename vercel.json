{
  "version": 2,
  "builds": [
    {
      "src": "**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    { "src": "/manifest.json", "dest": "/frontend/manifest.json" },
    { "src": "/sw.js", "dest": "/frontend/sw.js" },
    { "src": "/icon-192.png", "dest": "/frontend/icon-192.png" },
    { "src": "/icon-512.png", "dest": "/frontend/icon-512.png" },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/frontend/index.html" }
  ]
}
